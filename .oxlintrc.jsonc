{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./recommended.json", "./pedantic.json"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false,
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "error",
    "style": "warn",
    "restriction": "error",
    "nursery": "warn",
  },
  // https://github.com/oxc-project/javascript-globals/blob/main/src/lib.rs
  "env": {
    "builtin": true,
    "es2025": true,
    "es2026": true,
    "node": true,
    "commonjs": false,
  },
  "globals": {
    "Bun": "readonly",
  },
}
