{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsdoc", "node", "import", "promise", "unicorn", "typescript", "oxc"],
  "jsPlugins": ["./dist/oxclippy.js"],
  "extends": ["./dist/recommended.json"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "error",
    "style": "warn",
    "restriction": "error",
    "nursery": "warn"
  },
  "rules": {
    "eslint/capitalized-comments": "off",
    "eslint/curly": "off", // covered by formatters
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/func-names": ["error", "as-needed"],
    "eslint/func-style": ["error", "declaration", { "allowArrowFunctions": true }],
    "eslint/id-length": [
      "error",
      {
        "exceptionPatterns": ["^[A-Z]$"], // uppercase type names
        "exceptions": ["_", "a", "b", "i", "j", "h", "k", "n", "x", "y", "z"]
      }
    ],
    "eslint/init-declarations": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/max-params": "off",
    "eslint/max-statements": "off",
    "eslint/new-cap": [
      "error",
      {
        "capIsNew": false, // functional component names may be PascalCase
        "newIsCap": true, // constructor names must be capitalized
        "properties": true
      }
    ],
    "eslint/no-inline-comments": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-plusplus": ["error", { "allowForLoopAfterthoughts": true }],
    "eslint/no-ternary": "off",
    "eslint/no-undefined": "off",
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "args": "all", // prefer to prefix arg name with _
        "caughtErrors": "all",
        "vars": "all",
        "ignoreClassWithStaticInitBlock": false,
        "ignoreRestSiblings": false, // prefer to prefix var name with _
        "ignoreUsingDeclarations": false, // prefer to prefix var name with _
        "reportUsedIgnorePattern": true, // used vars must not have _ prefix
        "reportVarsOnlyUsedAsTypes": true
      }
    ],
    "eslint/no-void": "off",
    "eslint/one-var": ["error", "never"],
    // "eslint/sort-imports": "off", // covered by formatters
    "eslint/sort-imports": ["warn", { "ignoreCase": true, "ignoreDeclarationSort": true }], // TODO: Remove once oxfmt supports sorting import members.
    "eslint/sort-keys": "off",
    "eslint/yoda": ["warn", "never"],
    "import/consistent-type-specifier-style": "off", // covered by typescript
    "import/exports-last": "off",
    "import/extensions": ["error", "ignorePackages", { "checkTypeImports": true }],
    "import/group-exports": "off",
    "import/max-dependencies": "off",
    "import/no-named-export": "off",
    "import/no-nodejs-modules": "off",
    "import/no-relative-parent-imports": "off",
    "import/no-unassigned-import": "off",
    "import/prefer-default-export": "off",
    "jsdoc/check-tag-names": ["error", { "definedTags": ["remarks", "typeParam"], "typed": true }],
    "jsdoc/empty-tags": "warn", // allow @private markers with comment
    "node/no-process-env": "off", // can be used for build-time constants
    "oxc/no-async-await": "off",
    "oxc/no-const-enum": "off", // bun inlines at build-time
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxclippy/cognitive-complexity": "off", // covered by eslint/complexity
    "oxclippy/needless-range-loop": "off", // covered by typescript/prefer-for-of
    "oxclippy/prefer-structured-clone": "off", // covered by unicorn/prefer-structured-clone
    "oxclippy/too-many-lines": "off", // covered by eslint/max-lines-per-function
    "promise/always-return": ["error", { "ignoreLastCallback": true }],
    "promise/catch-or-return": ["error", { "allowThen": true }],
    "typescript/consistent-indexed-object-style": ["warn", "record"],
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-member-accessibility": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/prefer-readonly-parameter-types": ["warn", { "ignoreInferredTypes": true }],
    "typescript/promise-function-async": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/import-style": "off",
    "unicorn/no-null": "off",
    "unicorn/prefer-at": "off", // worse performance
    "unicorn/prefer-global-this": "off", // prefer clear distinction between Bun and DOM
    "unicorn/prefer-string-replace-all": "off", // poor runtime support and slower
    "unicorn/switch-case-braces": ["error", "avoid"] // byte savings when minification doesn't remove
  },
  "overrides": [
    {
      "files": ["*.js", "*.mjs", "*.cjs"],
      "rules": {
        "jsdoc/check-tag-names": ["error", { "definedTags": ["remarks"], "typed": false }]
      }
    },
    {
      "files": ["*.cjs"],
      "env": {
        "commonjs": true,
        "es2026": false
      },
      "rules": {
        "import/no-commonjs": "off",
        "import/unambiguous": "off",
        "oxc/no-async-await": "error",
        "typescript/no-require-imports": "off"
      }
    },
    {
      "files": ["*.ts"],
      "rules": {
        "jsdoc/require-param": "off",
        "jsdoc/require-param-type": "off",
        "jsdoc/require-returns": "off",
        "jsdoc/require-returns-type": "off"
      }
    },
    {
      "files": ["*.d.ts"],
      "rules": {
        "import/unambiguous": "off"
      }
    },
    {
      "files": ["*.config.ts", "*.config.mjs", "*.config.js"],
      "env": {
        "builtins": true,
        "es2026": true,
        "bun": true,
        "commonjs": false
      },
      "rules": {
        "eslint/func-style": ["error", "declaration"],
        "import/no-anonymous-default-export": "off",
        "import/no-default-export": "off",
        "node/no-sync": "off",
        "node/no-top-level-await": "off"
      }
    },
    {
      "files": ["*.test.ts", "*.spec.ts", "test/**"],
      "plugins": ["jest", "vitest"],
      "env": {
        "builtins": true,
        "es2026": true,
        "bun": true,
        "commonjs": false,
        "jest": true,
        "vitest": true
      },
      "rules": {
        "eslint/func-style": "off",
        "eslint/no-empty-function": "off",
        "eslint/no-magic-numbers": "off",
        "import/no-namespace": "off",
        "jest/no-commented-out-tests": "off", // covered by vitest/no-commented-out-tests
        "jest/no-conditional-in-test": "off", // covered by vitest/no-conditional-in-test
        "jest/prefer-each": "off", // covered by vitest/prefer-each
        "jest/require-hook": "off", // covered by vitest/require-hook
        "node/no-sync": "off",
        "node/no-top-level-await": "off",
        "oxclippy/similar-names": "off",
        "promise/catch-or-return": "off",
        "typescript/prefer-readonly-parameter-types": "off",
        "vitest/no-commented-out-tests": "warn",
        "vitest/prefer-importing-vitest-globals": "off" // use bun:test namespace imports
      }
    },
    {
      "files": ["build.ts"],
      "env": {
        "builtins": true,
        "es2026": true,
        "bun": true,
        "commonjs": false
      },
      "rules": {
        "eslint/func-style": ["error", "declaration"],
        "eslint/no-await-in-loop": "off",
        "eslint/no-console": "off",
        "eslint/no-magic-numbers": "off",
        "import/no-namespace": "off",
        "node/no-sync": "off",
        "node/no-top-level-await": "off",
        "typescript/prefer-readonly-parameter-types": "off"
      }
    }
  ]
}
