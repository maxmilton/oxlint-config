{
  "name": "@maxmilton/oxlint-config",
  "version": "0.0.23",
  "description": "Opinionated Oxlint configurations targeting the Bun ecosystem",
  "bugs": "https://github.com/maxmilton/oxlint-config/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmilton/oxlint-config.git"
  },
  "files": [
    "dist",
    "pedantic.json",
    "recommended.json",
    "stage1.json"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint:fmt && bun lint:js && bun lint:ts",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=5"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxclippy": "0.2.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "oxlint": "^1.88.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  }
}
